{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.0.3",
  "info": {
    "title": "mcp-governance Gateway Web Console API",
    "description": "轻量级控制面 REST 与 SSE 实时接口规范，用于驱动自包含 Web Admin Console，提供 Server 热启停、Tool Picker 勾选治理及实时脱敏审计流。",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/overview": {
      "get": {
        "summary": "获取网关全局监控大盘数据",
        "description": "聚合网关运行时状态、各下游服务数（总数/在线数/停用数）、聚合工具数及吞吐率统计",
        "responses": {
          "200": {
            "description": "成功返回大盘概览",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["gateway", "counts", "summary"],
                  "properties": {
                    "gateway": {
                      "type": "object",
                      "required": ["status", "version", "uptimeMs", "brand"],
                      "properties": {
                        "status": { "type": "string", "example": "UP" },
                        "version": { "type": "string", "example": "1.0.0" },
                        "brand": { "type": "string", "example": "mcp-governance" },
                        "uptimeMs": { "type": "integer", "example": 86400000 }
                      }
                    },
                    "counts": {
                      "type": "object",
                      "required": ["upstreamCount", "activeUpstreamCount", "toolCount", "activeToolCount"],
                      "properties": {
                        "upstreamCount": { "type": "integer", "example": 3 },
                        "activeUpstreamCount": { "type": "integer", "example": 2 },
                        "toolCount": { "type": "integer", "example": 25 },
                        "activeToolCount": { "type": "integer", "example": 18 }
                      }
                    },
                    "summary": {
                      "type": "object",
                      "required": ["totalInvocations", "totalSuccess", "totalAccessDenied", "totalValidationFailed", "totalError", "successRate", "deniedRate"],
                      "properties": {
                        "totalInvocations": { "type": "integer", "example": 1250 },
                        "totalSuccess": { "type": "integer", "example": 1200 },
                        "totalAccessDenied": { "type": "integer", "example": 35 },
                        "totalValidationFailed": { "type": "integer", "example": 10 },
                        "totalError": { "type": "integer", "example": 5 },
                        "successRate": { "type": "number", "example": 0.96 },
                        "deniedRate": { "type": "number", "example": 0.028 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/routes": {
      "get": {
        "summary": "获取已注册的 MCP Server 路由拓扑与运行状态",
        "description": "返回所有注册的下游 MCP Server 清单，包含协议类型、URI、前缀、在线健康状态及启停状态 (enabled)",
        "responses": {
          "200": {
            "description": "成功返回路由列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "protocol", "prefix", "enabled", "status"],
                    "properties": {
                      "id": { "type": "string", "example": "k8s-service" },
                      "protocol": { "type": "string", "enum": ["HTTP", "SSE", "STDIO"], "example": "HTTP" },
                      "prefix": { "type": "string", "example": "k8s_" },
                      "uri": { "type": "string", "example": "http://127.0.0.1:9001/mcp" },
                      "stdioCommand": { "type": "string", "example": "docker run -i ..." },
                      "enabled": { "type": "boolean", "example": true },
                      "status": { "type": "string", "enum": ["UP", "DOWN", "STOPPED"], "example": "UP" },
                      "aclMode": { "type": "string", "enum": ["WHITELIST", "BLACKLIST"], "example": "WHITELIST" },
                      "allowedToolsCount": { "type": "integer", "example": 5 },
                      "deniedToolsCount": { "type": "integer", "example": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/routes/status": {
      "post": {
        "summary": "一键热启停指定 MCP Server 路由",
        "description": "热启停下游服务路由。若停止该 Server，其所属所有 Tool 立即从 tools/list 聚合视图下线并不再参与路由分发与调用",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["routeId", "enabled"],
                "properties": {
                  "routeId": { "type": "string", "example": "k8s-service" },
                  "enabled": { "type": "boolean", "example": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "路由状态更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "routeId", "enabled", "status", "message"],
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "routeId": { "type": "string", "example": "k8s-service" },
                    "enabled": { "type": "boolean", "example": false },
                    "status": { "type": "string", "example": "STOPPED" },
                    "message": { "type": "string", "example": "Server 路由已热停用，下属工具已全部下线" }
                  }
                }
              }
            }
          },
          "400": { "description": "无效请求参数" },
          "404": { "description": "未找到匹配的路由 ID" }
        }
      }
    },
    "/api/v1/tools": {
      "get": {
        "summary": "查询全量工具资产发现清单与 Tool Picker 勾选状态",
        "description": "返回全量已注册工具清单，含所属下游 Server 状态、ACL 授权状态、Tool Picker 勾选激活状态 (enabled)",
        "responses": {
          "200": {
            "description": "成功返回工具列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "rawName", "upstreamId", "upstreamEnabled", "aclStatus", "enabled"],
                    "properties": {
                      "name": { "type": "string", "example": "k8s_get_pods" },
                      "rawName": { "type": "string", "example": "get_pods" },
                      "upstreamId": { "type": "string", "example": "k8s-service" },
                      "upstreamEnabled": { "type": "boolean", "example": true },
                      "description": { "type": "string", "example": "获取指定命名空间下的 Pod 列表" },
                      "aclStatus": { "type": "string", "enum": ["ALLOWED", "DENIED"], "example": "ALLOWED" },
                      "enabled": { "type": "boolean", "description": "Tool Picker 勾选状态（上游在线且 ACL 为 ALLOWED 时为 true）", "example": true },
                      "inputSchema": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools/acl": {
      "post": {
        "summary": "Tool Picker 勾选动态控制与 ACL 策略切换",
        "description": "针对特定工具通过勾选框 (ENABLE/DISABLE) 或动作 (ALLOW/DENY/RESET) 自由切换，未开启工具在 tools/list 阶段静默剔除",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["toolName"],
                "properties": {
                  "toolName": { "type": "string", "example": "k8s_get_pods" },
                  "enabled": { "type": "boolean", "description": "Tool Picker 勾选框状态（true 为勾选放行，false 为去勾选禁用）", "example": true },
                  "action": { "type": "string", "enum": ["ALLOW", "DENY", "RESET"], "description": "兼容细粒度 ACL 动作", "example": "ALLOW" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "策略更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "toolName", "currentStatus", "enabled"],
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "toolName": { "type": "string", "example": "k8s_get_pods" },
                    "currentStatus": { "type": "string", "example": "ALLOWED" },
                    "enabled": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "工具已启用并纳入 tools/list 暴露" }
                  }
                }
              }
            }
          },
          "400": { "description": "无效请求参数" },
          "404": { "description": "未找到匹配的工具路由" }
        }
      }
    },
    "/api/v1/audit/events": {
      "get": {
        "summary": "获取近期脱敏审计记录快照",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 50 }
          }
        ],
        "responses": {
          "200": {
            "description": "返回近期脱敏事件列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["eventId", "toolName", "callerRole", "status", "timestamp"],
                    "properties": {
                      "eventId": { "type": "string", "example": "evt-12345" },
                      "toolName": { "type": "string", "example": "k8s_delete_pod" },
                      "callerRole": { "type": "string", "example": "mcp-agent" },
                      "status": { "type": "string", "example": "SUCCESS" },
                      "maskedArguments": { "type": "object" },
                      "executionTimeMs": { "type": "integer", "example": 15 },
                      "timestamp": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit/stream": {
      "get": {
        "summary": "基于 SSE 的实时审计流长连接",
        "description": "建立 HTTP text/event-stream 连接，持续接收网关运行时脱敏审计事件瀑布流",
        "responses": {
          "200": {
            "description": "SSE 流式连接建立成功",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "example": "data: {\"eventId\":\"evt-123\",\"toolName\":\"k8s_get_pods\",\"status\":\"SUCCESS\"}\n\n"
                }
              }
            }
          }
        }
      }
    }
  }
}
