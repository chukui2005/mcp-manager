{
  "gateway": {
    "host": "127.0.0.1",
    "port": 18080,
    "requestTimeoutMs": 30000
  },
  "upstreams": [
    {
      "id": "weather-service",
      "protocol": "http",
      "prefix": "weather_",
      "uri": "http://127.0.0.1:19090/mcp"
    },
    {
      "id": "local-tools",
      "protocol": "stdio",
      "prefix": "local_",
      "stdioCommand": {
        "command": "node",
        "args": ["samples/demo-stdio-server.js"]
      }
    }
  ]
}
